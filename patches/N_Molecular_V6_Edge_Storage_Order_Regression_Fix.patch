+++ b/research/v6/source/tests/check_edge_storage_invariance.py
@@ -0,0 +1,86 @@
+#!/usr/bin/env python3
+"""Compare real v6 native receipts from original/reordered edge arrays.
+
+Only behavioral fields and separately declared trial metadata are compared.
+Physical-position serialized state hashes are not behavioral readouts.
+No mutation of source files, data or receipts.
+"""
+import argparse
+import json
+from pathlib import Path
+
+KEY = ('pdb', 'rep', 'closed', 'plastic', 'rewired')
+BEHAVIOR = ('temporal', 'scaffold_bins', 'molecular_bins', 'total_spikes',
+            'plastic_changes', 'feedback_trace')
+CONTROL = ('residues', 'topology_directed_contacts', 'all_edges',
+           'contact_degree_sha256', 'stimulus_sha256')
+EXPECTED_COUNTS = (2048, 6144)
+
+
+def read(path):
+    rows = [json.loads(line) for line in path.read_text().splitlines() if line]
+    if len(rows) not in EXPECTED_COUNTS:
+        raise AssertionError(f'{path}: unexpected row count {len(rows)}')
+    index = {}
+    for row in rows:
+        key = tuple(row[f] for f in KEY)
+        if key in index:
+            raise AssertionError(f'{path}: duplicate key {key}')
+        index[key] = row
+        if len(row['temporal']) != 4 * (118 + row['residues']):
+            raise AssertionError(f'{path}: malformed temporal vector for {key}')
+        if sum(row['temporal']) != row['total_spikes']:
+            raise AssertionError(f'{path}: inconsistent spike sum for {key}')
+        if 'feedback_trace' in row and len(row['feedback_trace']) != 47:
+            raise AssertionError(f'{path}: malformed feedback trace for {key}')
+    return index
+
+
+def verify(original, permuted):
+    if original.keys() != permuted.keys():
+        raise AssertionError('trial keys differ')
+    checks = 0
+    for key, a in original.items():
+        b = permuted[key]
+        for field in (*BEHAVIOR, *CONTROL):
+            if (field in a) != (field in b):
+                raise AssertionError(f'{key}: field presence differs: {field}')
+            if field in a and a[field] != b[field]:
+                raise AssertionError(f'{key}: {field} differs')
+            if field in a:
+                checks += 1
+    return checks
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('original', type=Path)
+    parser.add_argument('reversed', type=Path)
+    parser.add_argument('--historical', type=Path,
+                        help='requires byte identical, uninstrumented baseline receipt')
+    args = parser.parse_args()
+    if args.historical and args.original.read_bytes() != args.historical.read_bytes():
+        raise AssertionError('original edge order no longer reproduces the archive')
+    original = read(args.original)
+    reversed_rows = read(args.reversed)
+    checks = verify(original, reversed_rows)
+    # Negative self-check: detect altered real output without writing a fixture.
+    first = next(iter(original))
+    corrupted = dict(reversed_rows[first])
+    corrupted['total_spikes'] += 1
+    mutated = dict(reversed_rows)
+    mutated[first] = corrupted
+    try:
+        verify(original, mutated)
+    except AssertionError:
+        pass
+    else:
+        raise AssertionError('negative behavioral mutation escaped detection')
+    print(f'PASS: {len(original)} native records, {checks} behavioral/control checks, '
+          'and deliberate in-memory corruption rejected')
+    if 'feedback_trace' in next(iter(original.values())):
+        print('PASS: all 47 feedback targets per comparison were checked')
+
+
+if __name__ == '__main__':
+    main()
