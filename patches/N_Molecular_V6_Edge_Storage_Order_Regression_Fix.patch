@@ -58,6 +64,10 @@ Readout trial(const Case& c,unsigned rep,bool rewire,bool closed,bool plastic){
   }
  }else demand(false,"unknown single-stranded case");
  require_native(net->edge_count>=base_edges && residues+scaffold<=NM_MAX_NEURONS,"capacity/architecture invariant");
+#ifdef NM_V6_TEST_REVERSE_EDGE_STORAGE
+ std::reverse(net->edges,net->edges+net->edge_count);
+#endif
+ const auto stable_edge_slots=nm_v6::feedback_slots(*net,authored_edges);
  const unsigned total_edges=static_cast<unsigned>(net->edge_count);
  std::string degree_text="CONTACT_DEGREES|";
  for(unsigned id=0;id<scaffold+residues;++id)
@@ -82,9 +92,13 @@ Readout trial(const Case& c,unsigned rep,bool rewire,bool closed,bool plastic){
    if(closed){
     std::uint64_t sum=0, weighted=0;
     for(std::size_t k=0;k<previous_fired.size();++k)sum+=static_cast<std::uint64_t>(previous_fired[k]+1)*(k+1);
-    for(std::size_t e=0;e<net->edge_count;++e)weighted+=(e+1)*static_cast<std::uint64_t>(net->edges[e].weight);
+    for(std::size_t e=0;e<stable_edge_slots.size();++e)
+     weighted+=(e+1)*static_cast<std::uint64_t>(net->edges[stable_edge_slots[e]].weight);
     feedback_target=static_cast<unsigned>((sum+weighted%scaffold)%scaffold);
    }else feedback_target=(17+31*t)%scaffold;
+#ifdef NM_V6_TEST_TRACE_FEEDBACK
+   out.feedback_trace.push_back(feedback_target);
+#endif
    require_native(nm_inject(net.get(),static_cast<uint16_t>(feedback_target),net->tick,12)==0,"matched feedback intervention");
   }
   std::vector<int32_t> before(net->edge_count);
@@ -102,7 +116,7 @@ Readout trial(const Case& c,unsigned rep,bool rewire,bool closed,bool plastic){
   out.total_spikes+=static_cast<unsigned>(sp.count);
  }
  out.weights.reserve(base_edges);
- for(unsigned i=0;i<base_edges;++i)out.weights.push_back(net->edges[i].weight);
+ for(unsigned i=0;i<base_edges;++i)out.weights.push_back(net->edges[stable_edge_slots[i]].weight);
  out.final_sha256=surreal::hex(surreal::sha256(canonical_state(*net)));
  out.contact_degree_sha256=surreal::hex(surreal::sha256(degree_text));
  out.stimulus_sha256=surreal::hex(surreal::sha256(stimulus_history));
@@ -133,6 +147,9 @@ int main(int argc,char**argv){
      output<<",\"molecular_bins\":";four_json(output,v.molecule_spikes);
      output<<",\"temporal\":";array_json(output,v.temporal);
      output<<",\"base_weights\":";array_json(output,v.weights);
+#ifdef NM_V6_TEST_TRACE_FEEDBACK
+     output<<",\"feedback_trace\":";array_json(output,v.feedback_trace);
+#endif
      output<<"}\n";
     }
   demand(bool(output),"trial receipt write failure");
