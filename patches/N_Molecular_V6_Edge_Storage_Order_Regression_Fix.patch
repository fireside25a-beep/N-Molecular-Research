diff --git a/research/v6/source/native/stable_feedback_edge_slots.hpp b/research/v6/source/native/stable_feedback_edge_slots.hpp
new file mode 100644
index 0000000..c434c6b
--- /dev/null
+++ b/research/v6/source/native/stable_feedback_edge_slots.hpp
@@ -0,0 +1,48 @@
+#pragma once
+// V6 feedback boundary: preserve the authored edge ordinal independently of
+// mutable nm_network.edges[] storage order. No change to NeuroMantle C core.
+// Only the weight is mutable under STDP; all other edge fields form its key.
+#include "neuro_mantle.h"
+#include <cstddef>
+#include <deque>
+#include <map>
+#include <stdexcept>
+#include <tuple>
+#include <vector>
+
+namespace nm_v6 {
+using EdgeIdentity = std::tuple<uint16_t, uint16_t, uint16_t,
+                                int32_t, int32_t, int32_t,
+                                uint16_t, uint16_t, uint16_t>;
+inline EdgeIdentity identity(const nm_edge& e) {
+  return {e.src, e.dst, e.delay, e.initial_weight,
+          e.min_weight, e.max_weight,
+          e.plus, e.minus, e.window};
+}
+
+// Match the originally authored edges to the same *complete* edge records in
+// their current array positions. Identical duplicate records are indistinguishable
+// in the native transition; match them in increasing physical index order.
+inline std::vector<std::size_t> feedback_slots(
+    const nm_network& net, const std::vector<nm_edge>& authored) {
+  if (authored.size() != net.edge_count)
+    throw std::runtime_error("V6 authored-edge count differs from native edge count");
+  std::map<EdgeIdentity, std::deque<std::size_t>> locations;
+  for (std::size_t i=0; i<net.edge_count; ++i)
+    locations[identity(net.edges[i])].push_back(i);
+  std::vector<std::size_t> result;
+  result.reserve(authored.size());
+  for (const auto& edge : authored) {
+    const auto key=identity(edge);
+    auto it=locations.find(key);
+    if (it==locations.end() || it->second.empty())
+      throw std::runtime_error("V6 storage permutation changed an edge identity");
+    result.push_back(it->second.front());
+    it->second.pop_front();
+  }
+  for (const auto& entry : locations)
+    if (!entry.second.empty())
+      throw std::runtime_error("V6 unmatched stored edge identity");
+  return result;
+}
+} // namespace nm_v6
