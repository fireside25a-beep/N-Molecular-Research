+ std::vector<nm_edge> authored_edges;
  auto link=[&](unsigned u,unsigned v,int weight){
   require_native(nm_add_edge(net.get(),static_cast<uint16_t>(u),static_cast<uint16_t>(v),weight,1,plastic?3:0,plastic?2:0,7,0,32)==0,"add native synapse");
+  authored_edges.push_back(net->edges[net->edge_count-1]);
  };
